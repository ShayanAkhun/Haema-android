<resources>
    <style name="Theme.ViewFlow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Shown instantly on cold start (before any Compose UI loads), using the
         same illustration as the app icon so app identity is consistent from
         the moment the app launches. -->
    <style name="Theme.ViewFlow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ViewFlow</item>
    </style>
</resources>
